+it("sorts an older four-star stored recommendation ahead of newer quick praise without rewriting it", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "ccr-attention-"));
+  vi.stubEnv("CCR_STORE_DIR", dir);
