{
  "name": "compliment-complaint-reviewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "scan": "tsx scripts/dailyScan.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.mjs",
    "demo:prepare": "node scripts/demo.mjs --prepare-only",
    "build:comparison": "node --import tsx scripts/buildComparison.ts",
    "eval": "tsx scripts/evalRouting.ts",
    "eval:report": "tsx scripts/evalRouting.ts --report-only"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
