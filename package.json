{
  "name": "compliment-complaint-reviewer",
  "version": "0.1.0",
  "license": "MIT",
  "author": "withJia-tech",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "scan": "tsx --env-file-if-exists=.env.local scripts/dailyScan.ts",
    "read:golden": "tsx --env-file-if-exists=.env.local scripts/readReviews.ts golden",
    "read:demo": "tsx --env-file-if-exists=.env.local scripts/readReviews.ts demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:gate": "tsx scripts/evalGate.ts",
    "demo": "node scripts/demo.mjs",
    "demo:prepare": "node scripts/demo.mjs --prepare-only",
    "build:comparison": "node --import tsx scripts/buildComparison.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.26"
    }
  }
}
