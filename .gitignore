node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
.env*.local

# Runtime store is generated by `npm run scan` / server actions from fixtures.
# Keep the directory tracked (so a fresh checkout has somewhere to write) but
# ignore the generated JSON files themselves.
/data/store/*.json
!/data/store/.gitkeep

# Patches exported from git history (e.g. to hand work over when a push is
# blocked). The commits themselves are the source of truth.
*.patch

# Isolated synthetic sessions; each demo launch starts fresh.
/data/demo-sessions/
