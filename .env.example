# Copy to .env.local (git-ignored) and fill in. Never commit a real key.

# Your own Anthropic API key. Without it the app runs on keyword rules only.
# Use a key made just for this app, with a monthly spend limit set in the Anthropic Console.
ANTHROPIC_API_KEY=

# Second reader: claude (live, uses your key), cache (replay saved readings, no key), off.
# Unset: claude if ANTHROPIC_API_KEY is set, otherwise off.
# CCR_READER=cache
# CCR_READER_CACHE=data/readings/demo.json

# Model for the second reader. Default claude-opus-5-5.
# claude-haiku-5-5 costs about 40x less per review; check the golden dataset still passes if you switch.
# CCR_READER_MODEL=claude-opus-5-5
